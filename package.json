{
  "name": "matijuego-app",
  "version": "1.0.0",
  "private": true,
  "description": "Matijuego, el arcade de Matichoc, empaquetado como app Android con Capacitor.",
  "scripts": {
    "build:app": "node scripts/build.mjs app",
    "build:web": "node scripts/build.mjs web",
    "sync:android": "npm run build:app && npx cap sync android",
